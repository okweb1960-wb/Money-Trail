# Copy to .env.local and fill in. Never commit .env.local.

# api.data.gov key for the FEC API (free: https://api.data.gov/signup/)
# Without it, DEMO_KEY is used (about 30 requests/hour; too low for real pulls).
FEC_API_KEY=

# Optional: Senate LDA API key (https://lda.gov/api/register/). Anonymous access works but is throttled.
LDA_API_KEY=

# Optional: database location (default file:./prisma/dev.db)
# DATABASE_URL=file:./prisma/dev.db
